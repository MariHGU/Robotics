<?xml version="1.0"?>
<robot name="car_like_robot">

  <link name="world"/>

  <link name="base_link">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.5 0.2 0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0.3 0.3 0.7 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.5 0.3 0.1"/>
      </geometry>
    </collision>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>


<!-- Rear left wheel -->
<link name="rear_left_wheel">
  <visual>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <geometry><cylinder radius="0.1" length="0.05"/></geometry>
    <material name="black"><color rgba="0 0 0 1"/></material>
  </visual>
</link>

<joint name="rear_left_wheel_joint" type="fixed">
  <parent link="base_link"/>
  <child link="rear_left_wheel"/>
  <origin xyz="-0.20 0.15 -0.05"/>
</joint>

<!-- Rear right wheel -->
<link name="rear_right_wheel">
  <visual>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <geometry><cylinder radius="0.1" length="0.05"/></geometry>
    <material name="black"><color rgba="0 0 0 1"/></material>
  </visual>
</link>

<joint name="rear_right_wheel_joint" type="fixed">
  <parent link="base_link"/>
  <child link="rear_right_wheel"/>
  <origin xyz="-0.20 -0.15 -0.05"/>
</joint>

<!-- Front left steering link -->
<link name="front_left_steer"/>

<joint name="front_left_steer_joint" type="revolute">
  <parent link="base_link"/>
  <child link="front_left_steer"/>
  <origin xyz="0.20 0.15 -0.05"/>
  <axis xyz="0 0 1"/>
  <limit lower="-0.6109" upper="0.6109" effort="10" velocity="1"/>
</joint>

<!-- Front left wheel, fixed to steering link -->
<link name="front_left_wheel">
  <visual>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <geometry><cylinder radius="0.1" length="0.05"/></geometry>
    <material name="black"><color rgba="0 0 0 1"/></material>
  </visual>
</link>

<joint name="front_left_wheel_joint" type="fixed">
  <parent link="front_left_steer"/>
  <child link="front_left_wheel"/>
  <origin xyz="0 0 0"/>
</joint>

<!-- Front right steering link -->
<link name="front_right_steer"/>

<joint name="front_right_steer_joint" type="revolute">
  <parent link="base_link"/>
  <child link="front_right_steer"/>
  <origin xyz="0.20 -0.15 -0.05"/>
  <axis xyz="0 0 1"/>
  <limit lower="-0.6109" upper="0.6109" effort="10" velocity="1"/>
</joint>

<!-- Front right wheel, fixed to steering link -->
<link name="front_right_wheel">
  <visual>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <geometry><cylinder radius="0.1" length="0.05"/></geometry>
    <material name="black"><color rgba="0 0 0 1"/></material>
  </visual>
</link>

<joint name="front_right_wheel_joint" type="fixed">
  <parent link="front_right_steer"/>
  <child link="front_right_wheel"/>
  <origin xyz="0 0 0"/>
</joint>
</robot>